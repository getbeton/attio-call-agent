# Attio — Workspace settings → Developers → access token
ATTIO_API_KEY=
# Printed once by `node src/main.ts setup <public_url>`
ATTIO_WEBHOOK_SECRET=

# xAI — console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7
# CHAT_MODEL=grok-4.7
DRAFT_EFFORT=high
CHAT_EFFORT=low

# Telegram — @BotFather token, any random string, your numeric user id
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=

# Gmail — OAuth client of type "Desktop app"; refresh token from `node src/main.ts gmail-auth`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Who you are and who is who in a meeting
OWNER_EMAILS=you@yourcompany.com
OWNER_NAME=Alex
OWNER_TIMEZONE=Europe/Berlin
SENDER_NAME=Alex Smith
INTERNAL_DOMAINS=yourcompany.com
DEFAULT_SENDER=you@yourcompany.com
# partner domain = the address that sends the email when that partner is on the call
PARTNERS=partner.com=you@partner-desk.com

# Runtime
DATA_DIR=/data
LOOKBACK_DAYS=3
RECONCILE_HOURS=6
